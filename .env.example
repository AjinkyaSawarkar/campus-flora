# Copy to .env and fill in. On Vercel, add the same names under Project Settings -> Environment Variables.

# Reads posts and pages from Blogger (restrict the key to the Blogger API)
BLOGGER_API_KEY=
# BLOGGER_BLOG_ID=

# Suggests the plant's name on the "Add a photo" page. Free key from https://my.plantnet.org (500 photos a day).
# Without it the page still works; contributors just pick the name themselves.
PLANTNET_API_KEY=
